<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NamiSoft.Views.PayrollView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <StackPanel>
      <TextBlock Text="Nómina semanal" Classes="pageTitle"/>
      <TextBlock Text="Calcula horas, retardos, propinas, prima dominical y total a pagar." Classes="muted"/>
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
          <StackPanel Spacing="5">
            <TextBlock Text="Semana" Classes="fieldLabel"/>
            <DatePicker SelectedDate="{Binding WeekDate, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Propinas de la semana" Classes="fieldLabel"/>
            <NumericUpDown Value="{Binding Tips, Mode=TwoWay}" Minimum="0" Increment="50" MinWidth="150"/>
          </StackPanel>
          <StackPanel Grid.Column="3" HorizontalAlignment="Right">
            <TextBlock Text="TOTAL NÓMINA" Classes="muted" FontSize="11" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalPayroll, StringFormat='{}{0:C2}'}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
          <Button Classes="primary" Content="Calcular nómina" Command="{Binding CalculateCommand}"/>
          <Button Classes="ghost" Content="Exportar Excel" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <Grid MinWidth="1050" RowDefinitions="48,*">
          <Border Classes="tableHeader">
            <Grid ColumnDefinitions="2*,90,100,110,80,105,95,100,115" VerticalAlignment="Center">
              <TextBlock Text="Empleado" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="1" Text="Horas" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="2" Text="$ / hora" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="3" Text="Sueldo" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="4" Text="Retardos" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="5" Text="Descuento" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="6" Text="Propinas" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="7" Text="Prima Dom." Classes="tableHeaderText"/>
              <TextBlock Grid.Column="8" Text="Total" Classes="tableHeaderText"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" MinHeight="160">
            <ListBox Classes="data" ItemsSource="{Binding Rows}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tableRow">
                    <Grid ColumnDefinitions="2*,90,100,110,80,105,95,100,115">
                      <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding HorasTrabajadas}"/>
                      <TextBlock Grid.Column="2" Text="{Binding SalarioHora, StringFormat='{}{0:C2}'}"/>
                      <TextBlock Grid.Column="3" Text="{Binding SueldoBase, StringFormat='{}{0:C2}'}"/>
                      <TextBlock Grid.Column="4" Text="{Binding TotalRetardos}"/>
                      <TextBlock Grid.Column="5" Text="{Binding DescuentoRetardos, StringFormat='{}{0:C2}'}"/>
                      <TextBlock Grid.Column="6" Text="{Binding Propinas, StringFormat='{}{0:C2}'}"/>
                      <TextBlock Grid.Column="7" Text="{Binding PrimaDominical, StringFormat='{}{0:C2}'}"/>
                      <TextBlock Grid.Column="8" Text="{Binding TotalPagar, StringFormat='{}{0:C2}'}" FontWeight="Bold"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasRows}" Spacing="10" Margin="0,32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Nómina sin calcular." Classes="emptyTitle"/>
              <TextBlock Text="Elija la semana y pulse Calcular nómina para ver el total a pagar." Classes="emptyHint"/>
              <Button Classes="primary" Content="Calcular nómina" Command="{Binding CalculateCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
