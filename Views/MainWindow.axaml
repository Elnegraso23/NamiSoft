<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NominaPro.Views.MainWindow"
        Title="NominaPro"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="264,*">
    <Border Background="{DynamicResource SidebarBrush}" Padding="18,22">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Text="NOMINAPRO" Foreground="White" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="Control de asistencia y nómina" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="12"/>
        </StackPanel>

        <ListBox Grid.Row="1" Classes="nav" Margin="0,28,0,0"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="#374151" BorderThickness="0,1,0,0" Padding="0,16,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="ESTADO" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="{Binding AppState.EstadoArchivo}" Foreground="White" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding CurrentTime}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="80,*" Background="{DynamicResource PageBackgroundBrush}">
      <Border Background="White" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="28,0">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="{Binding PageTitle}" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="Casa Red · Administración" Classes="muted" FontSize="12"/>
          </StackPanel>
          <Border Grid.Column="1" Background="#EFF6FF" Padding="12,7" CornerRadius="16">
            <TextBlock Text="Avalonia · Linux / Windows" Foreground="#1D4ED8" FontSize="12" FontWeight="SemiBold"/>
          </Border>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="28"/>
    </Grid>
  </Grid>
</Window>
