<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NominaPro.Views.ManualScheduleView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <StackPanel>
      <TextBlock Text="Horario manual" Classes="pageTitle"/>
      <TextBlock Text="Consulta una semana y corrige manualmente horas de entrada o salida." Classes="muted"/>
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="5">
            <TextBlock Text="Empleado" Classes="fieldLabel"/>
            <ComboBox ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding NombreCompleto}"/></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Semana" Classes="fieldLabel"/>
            <DatePicker SelectedDate="{Binding WeekDate, Mode=TwoWay}"/>
          </StackPanel>
        </Grid>
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" HorizontalAlignment="Right">
          <Button Classes="ghost" Content="Buscar" Command="{Binding LoadCommand}"/>
          <Button Classes="primary" Content="Guardar cambios" Command="{Binding SaveCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <Grid MinWidth="900" RowDefinitions="48,*">
          <Border Classes="tableHeader">
            <Grid ColumnDefinitions="130,130,130,150,120,100,100" VerticalAlignment="Center">
              <TextBlock Text="Fecha" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="1" Text="Entrada" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="2" Text="Salida" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="3" Text="Horas trabajadas" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="4" Text="Retardo (min)" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="5" Text="Retardo" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="6" Text="Modificado" Classes="tableHeaderText"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1" MinHeight="160">
            <ListBox Classes="data" ItemsSource="{Binding Rows}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="16,8" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="130,130,130,150,120,100,100" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Text="{Binding Entrada, Mode=TwoWay}" PlaceholderText="HH:mm" Margin="0,0,10,0"/>
                      <TextBox Grid.Column="2" Text="{Binding Salida, Mode=TwoWay}" PlaceholderText="HH:mm" Margin="0,0,10,0"/>
                      <TextBlock Grid.Column="3" Text="{Binding HorasTrabajadas}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="4" Text="{Binding RetardoMinutos}" VerticalAlignment="Center"/>
                      <CheckBox Grid.Column="5" IsChecked="{Binding TieneRetardo}" IsEnabled="False"/>
                      <CheckBox Grid.Column="6" IsChecked="{Binding Modificado}" IsEnabled="False"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasRows}" Spacing="10" Margin="0,32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Sin checadas a la vista." Classes="emptyTitle"/>
              <TextBlock Text="Seleccione un empleado y pulse Buscar para ver y corregir su semana." Classes="emptyHint"/>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
