<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NamiSoft.Views.EmployeesView">
  <Grid RowDefinitions="Auto,*" RowSpacing="16">
    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,180" ColumnSpacing="10">
          <TextBox PlaceholderText="Buscar por nombre, número, puesto o departamento…"
                   Text="{Binding SearchText, Mode=TwoWay}"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"/>
        </Grid>
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
          <Button Classes="primary" Content="Nuevo" Command="{Binding NewEmployeeCommand}"/>
          <Button Classes="ghost" Content="Editar" Command="{Binding EditEmployeeCommand}"/>
          <Button Classes="ghost" Content="Activar / desactivar" Command="{Binding ToggleActiveCommand}"/>
          <Button Classes="ghost" Content="Sincronizar" Command="{Binding SyncPendingCommand}"/>
          <Button Classes="danger" Content="Eliminar" Command="{Binding DeleteEmployeeCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="card" Padding="0">
      <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <Grid MinWidth="880" RowDefinitions="48,*">
          <Border Classes="tableHeader">
            <Grid ColumnDefinitions="90,2*,1.2*,1.2*,120,110,110,75" VerticalAlignment="Center">
              <TextBlock Text="Número" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="1" Text="Nombre" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="2" Text="Puesto" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="3" Text="Departamento" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="4" Text="$ / hora" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="5" Text="Turno" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="6" Text="Descanso" Classes="tableHeaderText"/>
              <TextBlock Grid.Column="7" Text="Activo" Classes="tableHeaderText"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1" MinHeight="200">
            <ListBox Classes="data" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tableRow">
                    <Grid ColumnDefinitions="90,2*,1.2*,1.2*,120,110,110,75" VerticalAlignment="Center">
                      <TextBlock Text="{Binding NumeroEmpleado}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Puesto}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="3" Text="{Binding Departamento}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="4" Text="{Binding SalarioHora}"/>
                      <TextBlock Grid.Column="5" Text="{Binding Turno}"/>
                      <TextBlock Grid.Column="6" Text="{Binding Descanso}"/>
                      <CheckBox Grid.Column="7" IsChecked="{Binding Activo}" IsEnabled="False" HorizontalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding !HasEmployees}" Spacing="10" Margin="0,32"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="No hay empleados registrados todavía." Classes="emptyTitle"/>
              <TextBlock Text="Agregue al primero para empezar a controlar asistencia y nómina." Classes="emptyHint"/>
              <Button Classes="primary" Content="Agregar empleado" Command="{Binding NewEmployeeCommand}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
