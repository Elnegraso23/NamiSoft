<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NamiSoft.Views.ImportAttendanceView">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <StackPanel>
      <TextBlock Text="Importar checadas" Classes="pageTitle"/>
      <TextBlock Text="Selecciona el reporte de asistencia en Excel. Se muestra una vista previa antes de guardarlo." Classes="muted"/>
    </StackPanel>

    <Border Grid.Row="1" Classes="card">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding FilePath}" IsReadOnly="True" PlaceholderText="Ningún archivo seleccionado"/>
          <Button Grid.Column="1" Classes="ghost" Content="Seleccionar .xlsx" Command="{Binding SelectFileCommand}"/>
          <Button Grid.Column="2" Classes="primary" Content="Importar" Command="{Binding ImportCommand}" IsEnabled="{Binding CanImport}"/>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Classes="card" Padding="0">
      <Grid RowDefinitions="48,*">
        <Border Classes="tableHeader">
          <Grid ColumnDefinitions="110,2*,130,130,130" VerticalAlignment="Center">
            <TextBlock Text="Número" Classes="tableHeaderText"/>
            <TextBlock Grid.Column="1" Text="Nombre" Classes="tableHeaderText"/>
            <TextBlock Grid.Column="2" Text="Fecha" Classes="tableHeaderText"/>
            <TextBlock Grid.Column="3" Text="Entrada" Classes="tableHeaderText"/>
            <TextBlock Grid.Column="4" Text="Salida" Classes="tableHeaderText"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" MinHeight="160">
          <ListBox Classes="data" ItemsSource="{Binding Preview}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Classes="tableRow">
                  <Grid ColumnDefinitions="110,2*,130,130,130">
                    <TextBlock Text="{Binding NumeroEmpleado}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Nombre}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                    <TextBlock Grid.Column="3" Text="{Binding EntradaTexto}"/>
                    <TextBlock Grid.Column="4" Text="{Binding SalidaTexto}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding !HasPreview}" Spacing="10" Margin="0,32"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Aún no hay vista previa." Classes="emptyTitle"/>
            <TextBlock Text="Seleccione el archivo .xlsx del reloj checador para ver los registros antes de importarlos." Classes="emptyHint"/>
            <Button Classes="ghost" Content="Seleccionar .xlsx" Command="{Binding SelectFileCommand}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
